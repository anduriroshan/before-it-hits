# Cloud Build needs the staged region, which .gitignore excludes — so this file must exist,
# otherwise gcloud falls back to .gitignore and the image ships without its data.
.git
.gitignore
.venv
scratch
__pycache__
*.pyc
.pytest_cache
data/osm
.env
.env.local
# The submission deck is not part of the service, and Office's lock file (~$…) is unreadable
# while PowerPoint has the deck open — gcloud crashes on it mid-upload rather than skipping it.
*.pptx
*.pptx.bak
~$*
